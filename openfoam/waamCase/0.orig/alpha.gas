FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    bottom
    {
        type            zeroGradient;
        value           uniform 1;
    }
    top
    {
        type            inletOutlet;
        inletValue      uniform 1;
        value           uniform 1;
    }
    inlet
    {
        type            zeroGradient;
        value           uniform 1;
    }
    outlet
    {
        type            zeroGradient;
        value           uniform 1;
    }
    sides
    {
        type            zeroGradient;
        value           uniform 1;
    }
}
