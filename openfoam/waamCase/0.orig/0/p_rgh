FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 100000;

boundaryField
{
    bottom
    {
        type            fixedFluxPressure;
        value           uniform 100000;
    }
    top
    {
        type            totalPressure;
        value           uniform 100000;
        p0      uniform 100000;
    }
    inlet
    {
        type            zeroGradient;
        value           uniform 100000;
    }
    outlet
    {
        type            zeroGradient;
        value           uniform 100000;
    }
    sides
    {
        type            zeroGradient;
        value           uniform 100000;
    }
}
