FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.metal 0
    volScalarFieldValue T 300
);

regions
(
    boxToCell
    {
        box (-0.005 -0.015 -0.001) (0.030 0.015 0.008);
        fieldValues
        (
            volScalarFieldValue alpha.metal 1
            volScalarFieldValue T 300
        );
    }
);

