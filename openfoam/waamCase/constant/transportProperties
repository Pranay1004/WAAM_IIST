FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (metal gas);

metal
{
    transportModel  Newtonian;
    nu              8.86e-07;
    rho             7900;
}

gas
{
    transportModel  Newtonian;
    nu              1.5e-05;
    rho             1.6;
}

sigma           1.2;

